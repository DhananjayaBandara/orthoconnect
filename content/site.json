  "faqs": [
    {
      "question": "How do I book an appointment?",
      "answer": "Find your preferred clinic on the Clinics & Appointments page, then choose its eChannelling or Doc990 button. You will open Dr. Suneth De Silva’s sessions at that hospital. Select an available session and complete your booking with the provider."
    },
    {
      "question": "Where can I find consultation dates and times?",
      "answer": "Open the booking link for your preferred hospital to view the current session dates and times. Availability can change; the hospital or booking provider confirms your appointment."
    },
    {
      "question": "Where can I check consultation fees?",
      "answer": "Confirm current charges with your selected hospital or booking provider. Fees may vary by hospital, consultation type and treatment required. Prices are not published here."
    },
    {
      "question": "Can I book or pay directly through OrthoConnect?",
      "answer": "No. Appointments and payments are handled by the relevant hospital or external booking provider."
    },
    {
      "question": "Can I upload X-rays, scans or medical reports?",
      "answer": "No. This website does not collect or store medical reports and has no medical-file upload facility."
    },
    {
      "question": "Does Dr. De Silva assess difficult fracture healing?",
      "answer": "Yes. The documented scope includes assessment of fractures that have failed to unite or have healed abnormally, and selected limb-reconstruction problems."
    }
  ],
